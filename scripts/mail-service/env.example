# Relik mail service — пример окружения.
# Скопируйте в /etc/relik-mail.env, заполните и выставьте chmod 600.

# Слушает только localhost; наружу смотрит Caddy.
HOST=127.0.0.1
PORT=8100

# smtp  — напрямую через Яндекс/Mail.ru (лучше для RU, DMARC проходит).
# brevo — через API Brevo (300/сутки, без app password).
MAIL_PROVIDER=smtp

# --- SMTP (MAIL_PROVIDER=smtp) ---------------------------------
# Яндекс: включите «Почтовые программы» и создайте пароль приложения.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=relik.support@yandex.ru
SMTP_PASS=

# --- Brevo (MAIL_PROVIDER=brevo) -------------------------------
# Brevo → SMTP & API → API Keys → v3. Ключ вида xkeysib-...
BREVO_API_KEY=

# Адрес отправителя. Для smtp должен совпадать с SMTP_USER.
# Домен не обязателен: подойдёт бесплатный ящик.
MAIL_FROM="Relik <relik.support@yandex.ru>"

# Куда отвечать, если пользователь нажмёт «Ответить».
MAIL_REPLY_TO=relik.support@yandex.ru

# Нужен только для ссылок в письмах (magic link / recovery).
SUPABASE_URL=https://<project>.supabase.co

# Supabase → Authentication → Hooks → Send Email → сгенерировать секрет.
# Формат: v1,whsec_<base64>. Можно несколько секретов через | для ротации.
SEND_EMAIL_HOOK_SECRET=

# Сколько минут живёт код. Должно совпадать с Auth → Email OTP Expiry.
CODE_TTL_MINUTES=60

# Лимиты. Для Яндекса ~500 получателей/сутки, для Brevo Free — 300 писем.
RATE_PER_EMAIL=5
RATE_WINDOW_MS=900000
RATE_GLOBAL_PER_MIN=30

# 1 — не отправлять, только писать в лог (для локальной проверки).
DRY_RUN=0

# Таймаут провайдера. У Supabase на весь хук 5 секунд.
BREVO_TIMEOUT_MS=4000

# debug | info | warn | error
LOG_LEVEL=info
