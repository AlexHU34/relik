# Relik mail service behind Caddy.
# Замени 203.0.113.10 на реальный IP VPS.
#
# nip.io — бесплатный DNS: mail.203.0.113.10.nip.io указывает на 203.0.113.10.
# Caddy сам получит Let's Encrypt-сертификат, если открыты 80/443.

mail.203.0.113.10.nip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8100
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
